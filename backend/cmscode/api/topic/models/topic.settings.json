{
  "kind": "collectionType",
  "collectionName": "doc_topics",
  "info": {
    "name": "topic",
    "description": "Topic model for documentation system"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "project": {
      "model": "project",
      "via": "topics"
    },
    "subtopics": {
      "collection": "subtopic",
      "via": "topic"
    }
  }
}
