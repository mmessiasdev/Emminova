{
  "kind": "collectionType",
  "collectionName": "doc_contents",
  "info": {
    "name": "content",
    "description": "Content model for documentation system"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "body": {
      "type": "richtext"
    },
    "subtopic": {
      "model": "subtopic",
      "via": "contents"
    }
  }
}
